@article{internationaltreemortalitynetworkGlobalUnderstandingTree2025,
	title = {Towards a global understanding of tree mortality},
	volume = {245},
	rights = {© 2025 The Author(s). New Phytologist © 2025 New Phytologist Foundation.},
