64 citations (Semantic Scholar/{DOI}) [2026-01-06]},
	file = {Texte intégral:/Users/schwartz/Zotero/storage/E2RWX2L9/Abdullah et Singh - 2021 - Surgical Interventions for Inferior Turbinate Hype.pdf:application/pdf},
