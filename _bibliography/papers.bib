	urldate = {2025-01-29},
	date = {2024-08-22},
	note = {2 citations (Semantic Scholar/{DOI}) [2026-01-07]
0 citations (Crossref/{DOI}) [2026-01-07]},
	keywords = {forest inventory, temperate forest, random forest, tree species, satellite imagery, secondary tree growth},
	file = {Full Text PDF:/Users/schwartz/Zotero/storage/JHKIR7KM/Pellissier-Tanon et al. - 2024 - Combining satellite images with national forest inventory measurements for monitoring post-disturban.pdf:application/pdf},
