@misc{dekeersmaeckerForestPathsEuropeanGenus2024,
	title = {{ForestPaths}: European genus map},
	url = {https://zenodo.org/records/13341104},
	shorttitle = {{ForestPaths}},
	abstract = {This repository contains the 10 m resolution tree genus map of the year 2020 over Europe derived from Sentinel-1 and Sentinel-2 data. The map is available as {COGs} over a 100 km grid in the spatial reference system {EPSG} 3035 ({ETRS}89 / {LAEA} Europe). 

 

