@article{ciaisEuropewideReductionPrimary2005,
	title = {Europe-wide reduction in primary productivity caused by the heat and drought in 2003},
	volume = {437},
	rights = {2005 Springer Nature Limited},
	issn = {1476-4687},
	url = {https://www.nature.com/articles/nature03972},
	doi = {10.1038/nature03972},
	abstract = {The European heatwave in the summer of 2003 was probably the hottest in the region since {AD} 1500. Its immediate effects are well documented: the Earth Policy Institute has estimated that it caused at least 35,000 deaths. Now the longer-term effects are beginning to emerge. Based on measurements of ecosystem {CO}2 flux, radiation absorption by plants, crop yields and a model simulating the terrestrial biosphere, a multinational team of researchers has found that during July and August 2003, 500 million tonnes of carbon escaped from the forests and fields across Europe as a result of extreme heat and drought. The model results and historical data suggest that this dramatic fall in primary productivity is unprecedented during the past century. If the incidence of extreme droughts like this were to increase, temperate ecosystems could become carbon sources with the potential to accelerate global warming, as has been anticipated for the tropics.},
