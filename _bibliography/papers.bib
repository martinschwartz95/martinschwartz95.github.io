Conference Name: {IEEE} Journal of Selected Topics in Applied Earth Observations and Remote Sensing},
	keywords = {Sentinel-1, Sentinel-2, Forestry, Biomedical optical imaging, Optical imaging, Synthetic aperture radar, Satellites, regression, Data models, Deep learning ({DL}), Optical sensors, semisupervised, synthetic aperture radar ({SAR}), {UNet}},
