	author = {Franco, Marco A. and Rizzo, Luciana V. and Teixeira, Márcio J. and Artaxo, Paulo and Azevedo, Tasso and Lelieveld, Jos and Nobre, Carlos A. and Pöhlker, Christopher and Pöschl, Ulrich and Shimbo, Julia and Xu, Xiyan and Machado, Luiz A. T.},
