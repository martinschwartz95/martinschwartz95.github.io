0 citations (Crossref/{DOI}) [2026-01-07]
\_eprint: https://nph.onlinelibrary.wiley.com/doi/pdf/10.1111/nph.70634},
	keywords = {airborne {LiDAR}, biogeographic provinces, environmental factors, spatial modeling, tallest trees},
	file = {Full Text PDF:/Users/schwartz/Zotero/storage/Z5URP4QQ/de Lima et al. - Mapping the density of giant trees in the Amazon.pdf:application/pdf;Snapshot:/Users/schwartz/Zotero/storage/NQ486I6I/nph.html:text/html},
