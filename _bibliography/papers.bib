@article{gonzalez-garciaComparingEnvironmentalImpacts2014,
	title = {Comparing environmental impacts of different forest management scenarios for maritime pine biomass production in France},
	volume = {64},
	issn = {0959-6526},
	url = {https://www.sciencedirect.com/science/article/pii/S0959652613005015},
	doi = {10.1016/j.jclepro.2013.07.040},
	abstract = {Forest activities are receiving special attention in recent years concerning the quantification of their environmental profiles in order to be competitive. This study aims to evaluate the environmental profile of the production of maritime pine (Pinus pinaster Ait.) biomass in France under two different management scenarios (an intensive scenario: {IMS} and an extensive one: {EMS}), representative of the real practices in the country. Life Cycle Assessment ({LCA}) methodology was applied to evaluate the environmental loads from a cradle-to-gate perspective. According to the results, the choice of the best management scenario will depend on the impact category considered. Thus, {IMS} has lower fuel requirements and it is the best option in categories directly related to fuel consumption by forest machineries, such as abiotic resources depletion, cumulative energy demand, global warming potential and photochemical oxidants formation. On the contrary, {EMS} will be preferred in terms of acidification and eutrophication potentials with reductions of up to 26\%. The reason behind these reductions is based on the fact that these categories are considerably affected by the fertilizing process, which is not conducted under extensive conditions. Regardless the scenario, the logging stage and specially, the final cutting process, can be considered as the main environmental key factors, playing a major role in all categories. Both the production of the triple superphosphate and pruning processes play leading roles in the {IMS} and {EMS}, respectively. The comparison of these environmental profiles with those corresponding to maritime pine in Portugal highlights that the differences observed between both scenarios are related to the intensity of the forest practices as well as the biomass yield.},
	pages = {356--367},
	journaltitle = {Journal of Cleaner Production},
	shortjournal = {Journal of Cleaner Production},
	author = {González-García, S. and Bonnesoeur, V. and Pizzi, A. and Feijoo, G. and Moreira, M. T.},
	urldate = {2023-09-08},
	date = {2014-02-01},
	note = {38 citations (Semantic Scholar/{DOI}) [2026-01-07]
37 citations (Crossref/{DOI}) [2026-01-07]
38 citations (Semantic Scholar/{DOI}) [2026-01-06]},
	keywords = {Environmental profile, Extensive management, Forest systems, Intensive management, Life cycle assessment},
	file = {ScienceDirect Full Text PDF:/Users/schwartz/Zotero/storage/AU3U75L5/González-García et al. - 2014 - Comparing environmental impacts of different fores.pdf:application/pdf;ScienceDirect Snapshot:/Users/schwartz/Zotero/storage/FGU28E3Z/S0959652613005015.html:text/html},
}

@article{gallaunEUwideMapsGrowing2010,
	title = {{EU}-wide maps of growing stock and above-ground biomass in forests based on remote sensing and field measurements},
	volume = {260},
	issn = {0378-1127},
	url = {https://www.sciencedirect.com/science/article/pii/S0378112709007403},
	doi = {10.1016/j.foreco.2009.10.011},
	abstract = {The overall objective of this study was to combine national forest inventory data and remotely sensed data to produce pan-European maps on growing stock and above-ground woody biomass for the two species groups “broadleaves” and “conifers”. An automatic up-scaling approach making use of satellite remote sensing data and field measurement data was applied for {EU}-wide mapping of growing stock and above-ground biomass in forests. The approach is based on sampling and allows the direct combination of data with different measurement units such as forest inventory plot data and satellite remote sensing data. For the classification, data from the Moderate Resolution Imaging Spectroradiometer ({MODIS}) were used. Comprehensive field measurement data from national forest inventories for 98,979 locations from 16 countries were used for which tree species and growing stock estimates were available. The classification results were evaluated by comparison with regional estimates derived independently from the classification from national forest inventories. The validation at the regional level shows a high correlation between the classification results and the field based estimates with correlation coefficient r=0.96 for coniferous, r=0.94 for broadleaved and r=0.97 for total growing stock per hectare. The mean absolute error of the estimations is 25m3/ha for coniferous, 20m3/ha for broadleaved and 25m3/ha for total growing stock per hectare. Biomass conversion and expansion factors were applied to convert the growing stock classification results to carbon stock in above-ground biomass. As results of the classification, coniferous and broadleaved growing stock as well as carbon stock of the above-ground biomass is mapped on a wall-to-wall basis with a spatial resolution of 500m×500m per grid cell. The mapped area is 5millionkm2, of which 2millionkm2 are forests, and covers the whole European Union, the {EFTA} countries, the Balkans, Belarus, the Ukraine, Moldova, Armenia, Azerbaijan, Georgia and Turkey.},
	pages = {252--261},
	number = {3},
	journaltitle = {Forest Ecology and Management},
	shortjournal = {Forest Ecology and Management},
	author = {Gallaun, Heinz and Zanchi, Giuliana and Nabuurs, Gert-Jan and Hengeveld, Geerten and Schardt, Mathias and Verkerk, Pieter J.},
	urldate = {2023-09-08},
	date = {2010-06-30},
	note = {122 citations (Crossref/{DOI}) [2026-01-07]
122 citations (Crossref/{DOI}) [2026-01-07]},
	keywords = {Remote sensing, Biomass, Carbon, Forest inventory, Growing stock, {MODIS}},
	file = {ScienceDirect Full Text PDF:/Users/schwartz/Zotero/storage/LYADDR5Z/Gallaun et al. - 2010 - EU-wide maps of growing stock and above-ground bio.pdf:application/pdf;ScienceDirect Snapshot:/Users/schwartz/Zotero/storage/4MUBQ94B/S0378112709007403.html:text/html},
}

@article{jiEstimatingAbovegroundBiomass2012,
	title = {Estimating aboveground biomass in interior Alaska with Landsat data and field measurements},
	volume = {18},
	issn = {1569-8432},
	url = {https://www.sciencedirect.com/science/article/pii/S0303243412000633},
	doi = {10.1016/j.jag.2012.03.019},
	abstract = {Terrestrial plant biomass is a key biophysical parameter required for understanding ecological systems in Alaska. An accurate estimation of biomass at a regional scale provides an important data input for ecological modeling in this region. In this study, we created an aboveground biomass ({AGB}) map at 30-m resolution for the Yukon Flats ecoregion of interior Alaska using Landsat data and field measurements. Tree, shrub, and herbaceous {AGB} data in both live and dead forms were collected in summers and autumns of 2009 and 2010. Using the Landsat-derived spectral variables and the field {AGB} data, we generated a regression model and applied this model to map {AGB} for the ecoregion. A 3-fold cross-validation indicated that the {AGB} estimates had a mean absolute error of 21.8Mg/ha and a mean bias error of 5.2Mg/ha. Additionally, we validated the mapping results using an airborne lidar dataset acquired for a portion of the ecoregion. We found a significant relationship between the lidar-derived canopy height and the Landsat-derived {AGB} (R2=0.40). The {AGB} map showed that 90\% of the ecoregion had {AGB} values ranging from 10Mg/ha to 134Mg/ha. Vegetation types and fires were the primary factors controlling the spatial {AGB} patterns in this ecoregion.},
	pages = {451--461},
	journaltitle = {International Journal of Applied Earth Observation and Geoinformation},
	shortjournal = {International Journal of Applied Earth Observation and Geoinformation},
	author = {Ji, Lei and Wylie, Bruce K. and Nossov, Dana R. and Peterson, Birgit and Waldrop, Mark P. and {McFarland}, Jack W. and Rover, Jennifer and Hollingsworth, Teresa N.},
	urldate = {2023-09-09},
	date = {2012-08-01},
	note = {31 citations (Semantic Scholar/{DOI}) [2026-01-07]
39 citations (Crossref/{DOI}) [2026-01-07]
31 citations (Semantic Scholar/{DOI}) [2026-01-06]},
	keywords = {Landsat, Lidar, Aboveground biomass, Alaska, Spectral vegetation index, Yukon Flats ecoregion},
	file = {ScienceDirect Full Text PDF:/Users/schwartz/Zotero/storage/WKRBRW65/Ji et al. - 2012 - Estimating aboveground biomass in interior Alaska .pdf:application/pdf;ScienceDirect Snapshot:/Users/schwartz/Zotero/storage/AXHAZTXK/S0303243412000633.html:text/html},
}

@article{cartusNationalDetailedMap2014,
	title = {A National, Detailed Map of Forest Aboveground Carbon Stocks in Mexico},
	volume = {6},
	rights = {http://creativecommons.org/licenses/by/3.0/},
	issn = {2072-4292},
	url = {https://www.mdpi.com/2072-4292/6/6/5559},
	doi = {10.3390/rs6065559},
	abstract = {A spatially explicit map of aboveground carbon stored in Mexico’s forests was generated from empirical modeling on forest inventory and spaceborne optical and radar data. Between 2004 and 2007, the Mexican National Forestry Commission ({CONAFOR}) established a network of {\textasciitilde}26,000 permanent inventory plots in the frame of their national inventory program, the Inventario Nacional Forestal y de Suelos ({INFyS}). {INFyS} data served as model response for spatially extending the field-based estimates of carbon stored in the aboveground live dry biomass to a wall-to-wall map, with 30 × 30 m2 pixel posting using canopy density estimates derived from Landsat, L-Band radar data from {ALOS} {PALSAR}, as well as elevation information derived from the Shuttle Radar Topography Mission ({SRTM}) data set. Validation against an independent set of {INFyS} plots resulted in a coefficient of determination (R2) of 0.5 with a root mean square error ({RMSE}) of 14 t∙C/ha  in the case of flat terrain. The validation for different forest types showed a consistently low estimation bias ({\textless}3 t∙C/ha) and R2s in the range of 0.5 except for mangroves (R2 = 0.2). Lower accuracies were achieved for forests located on steep slopes ({\textgreater}15°) with an R2 of 0.34. A comparison of the average carbon stocks computed from: (a) the map; and (b) statistical estimates from {INFyS}, at the scale of {\textasciitilde}650 km2 large hexagons (R2 of 0.78, {RMSE} of 5 t∙C/ha) and Mexican states (R2 of 0.98, {RMSE} of 1.4 t∙C/ha), showed strong agreement.},
	pages = {5559--5588},
	number = {6},
	journaltitle = {Remote Sensing},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Cartus, Oliver and Kellndorfer, Josef and Walker, Wayne and Franco, Carol and Bishop, Jesse and Santos, Lucio and Fuentes, José María Michel},
	urldate = {2023-09-09},
	date = {2014-06},
	langid = {english},
	note = {110 citations (Crossref/{DOI}) [2026-01-07]
118 citations (Semantic Scholar/{DOI}) [2026-01-06]
