@article{vennetierEvaluationCroissancePin,
	title = {Évaluation de la croissance du pin d'Alep en région méditerranéenne française},
	abstract = {This article presents a model aiming at the assessment of the potential productivity of Pinus halepensis in any environment within the French Mediterranean region, even without existing stand. Local water balance is the key issue for Aleppo pine growth. Climate plays a complex role due to interactions between rainfall and temperature: no optimal combination of these two variables exist in the study area. Aleppo pine fears heavy snow and deep frost. The best productivity is obtained in sites with excellent water balance between 100 and 300 m in elevation. Thanks to its high resistance to drought and adaptability to nearly all types of soil, Aleppo pine can grow or at least survive in about any place in the French Mediterranean region below 700 m. Climate change could change the present balance. Climatic water deficits should no longer be remediated by favorable site conditions, so that Aleppo pine may disappear from the worse sites, and its productivity could decrease in a large proportion of its present distribution area. The tool presented in this paper should probably be updated in a few decades.},
	author = {Vennetier, M and Ripert, C and Brochiéro, F and Rathgeber, Cyrille and Chandioux, O and Esteve, R},
	langid = {french},
	file = {Vennetier et al. - Évaluation de la croissance du pin d'Alep en régio.pdf:/Users/schwartz/Zotero/storage/9WUF9WCX/Vennetier et al. - Évaluation de la croissance du pin d'Alep en régio.pdf:application/pdf},
