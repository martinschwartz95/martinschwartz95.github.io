	note = {145 citations (Semantic Scholar/{DOI}) [2026-01-07]
136 citations (Crossref/{DOI}) [2026-01-07]
145 citations (Semantic Scholar/{DOI}) [2026-01-06]},
	keywords = {Remote sensing, Climate change, Carbon stocks, Reducing emissions from deforestation and forest degradation ({REDD}), Sustainable Development Goals ({SDGs})},
	file = {Full Text PDF:/Users/schwartz/Zotero/storage/T4IX7GDX/Herold et al. - 2019 - The Role and Need for Space-Based Forest Biomass-R.pdf:application/pdf},
