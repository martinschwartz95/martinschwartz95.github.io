@article{schwartzFORMSpoTRevealingFinescale2026,
	title = {{FORMSpoT}: Revealing fine-scale forest disturbances from nation-wide 1.5 m forest canopy height time series},
	volume = {346},
	issn = {0034-4257},
	url = {https://www.sciencedirect.com/science/article/pii/S0034425726004013},
	doi = {10.1016/j.rse.2026.115631},
	shorttitle = {{FORMSpoT}},
	abstract = {Current large-scale satellite-based forest disturbance monitoring systems operate at 10–30 m resolution, which is too coarse to detect changes at the scale of individual trees resulting in a systematic underestimation of forest disturbances. Here, we introduce {FORMSpoT} (Forest Mapping with {SPOT} Time series), a decade-long (2014-2024), country-scale mapping of forest canopy height at 1.5 m resolution over France, together with {FORMSpoT}-Δ, annual disturbance polygons derived from height differences in the {FORMSpoT} time series. Canopy heights were derived from annual {SPOT}-6/7 composites using a hierarchical transformer model ({PVTv}2) trained on high-resolution airborne laser scanning ({ALS}) data. To enable robust change detection, we developed a post-processing pipeline combining co-registration and spatio-temporal total variation denoising. We find that (1) the French disturbance regime is dominated by small events. Sub-100 m2 disturbances alone represent 72\% of all events, and disturbances below 0.1 ha account for 97\% of events and 39\% of the disturbed area. These events are largely missed by Sentinel-1/2 and Landsat-based products. (2) Validated against successive {ALS} revisits across 19 sites and 5087 {NFI} plot revisits, {FORMSpoT}-Δ provides reliable detection (F1 {\textgreater} 0.8) above 100 m2 while retaining sensitivity to finer events that coarser products do not capture. (3) At the national scale, {FORMSpoT}-Δ resolves contrasted disturbance regimes, from clear-cut-dominated dynamics in maritime pine plantations to diffuse, smaller disturbance events in mountain forests, and captures their temporal dynamics, including the salvage-logging signature of the 2017–2022 bark beetle crisis in northeastern France.},
	pages = {115631},
	journaltitle = {Remote Sensing of Environment},
	shortjournal = {Remote Sensing of Environment},
	author = {Schwartz, Martin and Fogel, Fajwel and Besic, Nikola and Robert, Damien and Geist, Louis and Renaud, Jean-Pierre and Monnet, Jean-Matthieu and Mosig, Clemens and Vega, Cédric and d’Aspremont, Alexandre and Landrieu, Loic and Ciais, Philippe},
	urldate = {2026-08-26},
	date = {2026-12-01},
	keywords = {Forest height, {ALS}, Deep learning, Time series, Vision transformers, Canopy gaps, Forest disturbances, {SPOT}},
	file = {ScienceDirect Full Text PDF:/Users/schwartz/Zotero/storage/PVPXA2PY/Schwartz et al. - 2026 - FORMSpoT Revealing fine-scale forest disturbances from nation-wide 1.5 m forest canopy height time.pdf:application/pdf;ScienceDirect Snapshot:/Users/schwartz/Zotero/storage/KK7M8ZFA/S0034425726004013.html:text/html},
}

@misc{sentyExtentDynamicsTropical2025,
	location = {Rochester, {NY}},
	title = {Extent and Dynamics of Tropical Flooded Forests with Mul-ti-Year {SAR} Composites and Altimetry},
	url = {https://papers.ssrn.com/abstract=5936866},
	doi = {10.2139/ssrn.5936866},
	abstract = {Flood dynamics regulate greenhouse gas emissions from tropical flooded forests, but monitoring flooding beneath dense canopies is challenging. We introduce a L-band {SAR} approach that uses more than a decade of {ALOS}-2 {PALSAR}-2 observations to detect sub-canopy flooding at 100m resolution across the Amazon and Congo rainforests. We generate multi-year composites of {HH} and {HV} backscatter that represent low-, intermediate-, and high-water river stages. These stages are defined at a local scale using over 4,000 satellite altimetry time series, accounting for the large hydrological variability across both rainforests. Flooded forests display a characteristic dual-polarization signature: {HV} backscatters are comparable to non-flooded forests, while {HH} backscatters are higher due to double-bounce scattering. Using this signature, quantified by an ad hoc index, we determine the extent of flooded forests at high-water stage and estimate flood frequency across the hydrological cycle. The resulting maps capture the seasonal water dynamics of forested wetlands at 100m resolution, revealing complex spatial patterns across both floodplains and interfluvial wetlands. We detected over 900,000 km2 of flooded forests ({\textasciitilde}740,000 km2 in the Amazon and {\textasciitilde}179,000km2 in the Congo rainforest). Our estimates agree closely with existing products in the Amazon, and the Congo estimates are supported, at a local scale, by an airborne {SAR} observation in the Cuvette Centrale. By resolving both the extent and seasonal dynamics of flooded forests at 100m resolution, these maps can support ecological, hydrological, and carbon studies in tropical forests.},
	number = {5936866},
	publisher = {Social Science Research Network},
	author = {Senty, Paul and Kittel, Cécile and Papa, Fabrice and Fensholt, Rasmus and Coppo Frias, Monica and Horion, Stéphanie},
	urldate = {2026-09-10},
	date = {2025-12-18},
	langid = {english},
	keywords = {Amazon, Congo, flooded forests, flooding, floodplains, {PALSAR}-2, wetlands},
}

@article{viana-sotoDeepLearningbasedForest2026,
	title = {Deep learning-based forest disturbance detection for Europe using Landsat time series},
	volume = {347},
	issn = {0034-4257},
	url = {https://www.sciencedirect.com/science/article/pii/S0034425726004402},
	doi = {10.1016/j.rse.2026.115670},
	abstract = {Forests in Europe are under growing pressure from climate extremes and land use intensification. Long-term monitoring is therefore required to understand disturbance dynamics, yet producing temporally and spatially consistent disturbance maps at continental scales remains challenging. Emerging deep learning models might improve upon existing models by learning spectral-temporal patterns relevant for disturbance detection directly from the underlying data, while simultaneously ignoring noise. Despite their promise, deep learning models have not yet been used for continental-scale disturbance mapping. Here, we implemented two temporal deep learning models ({TempCNN} and 1D U-Net) for annual forest disturbance detection across all forests of continental Europe using Landsat time series from 1985 to 2024. We evaluated the performance of both models for detecting forest disturbances using short temporal subsequences from the whole time series and compared them to existing approaches based on Random Forest. The 1D U-Net outperformed the {TempCNN} and Random Forest models across variable classification scenarios. The highest performance was achieved using the 5-year input window. Using the 1D U-Net model, we generated annual forest disturbance maps at 30 m resolution for Europe since 1985, with a total disturbed forest area of 48.5 Mha. Map validation using an independent validation dataset yielded an F1 score of 0.81 in spatial disturbance detection, with balanced commission and omission errors (18.4\% and 19.8\%, respectively), and less variability in commission and omission errors over time than previous maps and alternative models. Using a temporal convolutional architecture thus led to more consistent disturbance mapping across space and time compared to previous approaches. The proposed model is further designed to support updates as new observations arrive and to operate effectively with short temporal sequences, facilitating operational forest disturbance monitoring across Europe.},
	pages = {115670},
	journaltitle = {Remote Sensing of Environment},
	shortjournal = {Remote Sensing of Environment},
	author = {Viana-Soto, Alba and Mense, Jorunn Anna and Kowalski, Katja and Pauls, Jan and Gieseke, Fabian and Senf, Cornelius},
	urldate = {2026-09-18},
	date = {2026-12-15},
	keywords = {Europe, Landsat time series, Forest disturbances, 1D U-Net, {TempCNN}},
	file = {ScienceDirect Full Text PDF:/Users/schwartz/Zotero/storage/4RHN2RED/Viana-Soto et al. - 2026 - Deep learning-based forest disturbance detection for Europe using Landsat time series.pdf:application/pdf;ScienceDirect Snapshot:/Users/schwartz/Zotero/storage/Q22T524L/S0034425726004402.html:text/html},
}

@article{oplerProtoTreeEfficientGeneralizable2026,
	title = {{ProtoTree}: An Efficient and Generalizable Model for Individual Tree Point Clouds Analysis},
	volume = {64},
	issn = {1558-0644},
	url = {https://ieeexplore.ieee.org/document/11602112},
	doi = {10.1109/TGRS.2026.3711722},
	shorttitle = {{ProtoTree}},
	abstract = {Accurate estimation of tree volume, biomass, and species is central to carbon accounting and biodiversity monitoring. However, current methods either depend on costly field inventories or heavy geometric fitting. We present {ProtoTree}, a prototype-based pretraining framework optimized to reconstruct a per-tree point cloud by deforming a single learnable prototype, yielding compact and interpretable geometric descriptors. These descriptors explicitly capture tree-scale structural variation and enable label-efficient regression of individual-tree wood volume, which is subsequently combined with species-specific wood density to estimate above-ground biomass ({AGB}) from raw {TLS}, {ULS}, or {ALS} point clouds. With only 180 labeled trees, {ProtoTree} reaches R{\textasciicircum}2 = 0.94 for volume prediction compared to R{\textasciicircum}2 = 0.76 for a fully supervised alternative. Combined with a supervised classifier to predict species, our pipeline reproduces {TLS}-derived {AGB} with an {MAE} of 0.20 ton (against 0.36 ton using standard allometry equations), while requiring {\textbackslash}approx 3 orders of magnitude less computation than quantitative structure models ({QSMs}). These results highlight {ProtoTree} as a scalable, label-efficient framework for operational forest inventories. With robust segmentation, it could enable large-scale carbon stock estimation and ecological monitoring of single trees. Our code and models are accessible at https://github.com/{LSCE}-forest/{ProtoTree}},
	pages = {4414315--4414315},
	journaltitle = {{IEEE} Transactions on Geoscience and Remote Sensing},
	author = {Opler, Alvin and Ciais, Philippe and Fayad, Ibrahim and Schwartz, Martin and Belouze, Gabriel and Brood, Sarah and D'Aspremont, Alexandre and Gominski, Dimitri and Aubry, Mathieu and Landrieu, Loic},
	urldate = {2026-09-29},
	date = {2026-07},
	keywords = {above-ground biomass, Biomass, Vegetation, forest inventory, Modeling, Clouds, Training, carbon accounting, self-supervised learning, Forests, Trees (botanical), 3D deep learning, Deformation, Grounding, Labeling, tree volume estimation, 3-D deep learning ({DL}), above-ground biomass ({AGB}), self-supervised learning ({SSL})},
	file = {PDF:/Users/schwartz/Zotero/storage/M455X2QW/Opler et al. - 2026 - ProtoTree An Efficient and Generalizable Model for Individual Tree Point Clouds Analysis.pdf:application/pdf;Snapshot:/Users/schwartz/Zotero/storage/VYMT9N2N/11602112.html:text/html},
}

@misc{vautierFLORADeepLearning2026,
	title = {{FLORA}: A deep learning approach to predict forest attributes from heterogeneous {LiDAR} data},
	url = {http://arxiv.org/abs/2606.32023},
	doi = {10.48550/arXiv.2606.32023},
	shorttitle = {{FLORA}},
	abstract = {Forest attributes are essential for national-scale resource monitoring. Airborne {LiDAR} metrics are among the auxiliary variables most strongly correlated with forest attributes used in National Forest Inventory ({NFI}) estimates. However, producing wall-to-wall predictions remains challenging when {LiDAR} data are acquired under heterogeneous conditions. As national {LiDAR} programs expand across Europe, variability in sensors, flight parameters, seasons, and scan angles limits the robustness of existing models, which are often calibrated for local conditions. We present {FLORA} (Forest {LiDAR} Octree Regression with Auxiliary Data), a deep learning framework that predicts six forest attributes: dominant height, total volume, deciduous volume, coniferous volume, basal area, and stem density from heterogeneous {LiDAR} point clouds. {FLORA} combines an octree-based backbone with ecological and spatiotemporal auxiliary variables through a late-fusion gating mechanism. Models are trained and evaluated on 32,052 National Forest Inventory plots across mainland France using data from the French {LiDAR} {HD} program. A single model trained on both leaf-on and leaf-off acquisitions outperforms season-specific models and improves cross-season robustness. Auxiliary variables provide modest overall gains but contribute more strongly to species-specific volume prediction. {FLORA} achieves an {rRMSE} of about 12.3\% (R2 = 0.88) for dominant height and 39\% (R2 = 0.74) for total volume, providing a robust baseline for large-scale forest attribute estimation from heterogeneous national {LiDAR} programs.},
	number = {{arXiv}:2606.32023},
	publisher = {{arXiv}},
	author = {Vautier, Emilie and Mallet, Clément and Vega, Cédric},
	urldate = {2026-10-01},
	date = {2026-06-30},
	eprinttype = {arxiv},
	eprint = {2606.32023 [cs.CV]},
	keywords = {Computer Science - Computer Vision and Pattern Recognition, Computer Science - Artificial Intelligence},
	file = {Preprint PDF:/Users/schwartz/Zotero/storage/TB57JQNS/Vautier et al. - 2026 - FLORA A deep learning approach to predict forest attributes from heterogeneous LiDAR data.pdf:application/pdf;Snapshot:/Users/schwartz/Zotero/storage/J866V8QJ/2606.html:text/html},
}

@article{slagterMonitoringDirectDrivers2023,
	title = {Monitoring direct drivers of small-scale tropical forest disturbance in near real-time with Sentinel-1 and -2 data},
	volume = {295},
	issn = {0034-4257},
	url = {https://www.sciencedirect.com/science/article/pii/S0034425723002067},
	doi = {10.1016/j.rse.2023.113655},
	abstract = {Advancements in satellite-based forest monitoring increasingly enable the near real-time detection of small-scale tropical forest disturbances. However, there is an urgent need to enhance such monitoring methods with automated direct driver attributions to detected disturbances. This would provide important additional information to make forest disturbance alerts more actionable and useful for uptake by different stakeholders. In this study, we demonstrate spatially explicit and near real-time methods to monitor direct drivers of small-scale tropical forest disturbance across a range of tropical forest conditions in Suriname, the Republic of the Congo and the Democratic Republic of the Congo. We trained a convolutional neural network with Sentinel-1 and Sentinel-2 data to continuously classify newly detected {RAdar} for Detecting Deforestation ({RADD}) alerts as smallholder agriculture, road development, selective logging, mining or other. Different monitoring scenarios were evaluated based on varying sensor combinations, post-disturbance time periods and confidence levels. In general, the use of Sentinel-2 data was found to be most accurate for driver classifications, especially with data composited over a period of 4 to 6 months after the disturbance detection. Sentinel-1 data showed to be valuable for more rapid classifications of specific drivers, especially in areas with persistent cloud cover. Throughout all monitoring scenarios, smallholder agriculture was classified most accurately, while road development, selective logging and mining were more challenging to distinguish. An accuracy assessment throughout the full extent of our study regions revealed a Macro-F1 score of 0.861 and an Overall Accuracy of 0.897 for the best performing model, based on the use of 6-month post-disturbance Sentinel-2 composites. Finally, we addressed three specific monitoring use cases that relate to rapid law enforcement against illegal activities, ecological impact assessments and timely carbon emission reporting, by optimizing the trade-off in classification timeliness and confidence to reach required accuracies. Our findings demonstrate the strong capacities of high spatiotemporal resolution satellite data for monitoring direct drivers of small-scale forest disturbance, considering different user interests. The produced forest disturbance driver maps can be accessed via: https://bartslagter94.users.earthengine.app/view/forest-disturbance-drivers.},
	pages = {113655},
	journaltitle = {Remote Sensing of Environment},
	shortjournal = {Remote Sensing of Environment},
	author = {Slagter, Bart and Reiche, Johannes and Marcos, Diego and Mullissa, Adugna and Lossou, Etse and Peña-Claros, Marielos and Herold, Martin},
	urldate = {2026-10-02},
	date = {2023-09-01},
	keywords = {Deep learning, Forest degradation, Tropical forest, Selective logging, Deforestation, Driver attribution, Mining, Near real-time monitoring, Road development, Small-scale forest disturbance, Smallholder agriculture},
	file = {ScienceDirect Full Text PDF:/Users/schwartz/Zotero/storage/EY9T5W5Y/Slagter et al. - 2023 - Monitoring direct drivers of small-scale tropical forest disturbance in near real-time with Sentinel.pdf:application/pdf;ScienceDirect Snapshot:/Users/schwartz/Zotero/storage/C4NN69IF/S0034425723002067.html:text/html},
}

@misc{ligensaPixelLevelTransformersRemote2026,
	title = {Pixel-Level Transformers in Remote Sensing: A Canopy Height Case Study},
	url = {http://arxiv.org/abs/2609.37809},
	doi = {10.48550/arXiv.2609.37809},
	shorttitle = {Pixel-Level Transformers in Remote Sensing},
	abstract = {Predicting canopy height from medium-resolution satellite imagery is a common and scalable approach for assessing the condition of the world's forests, which play a crucial role in climate change mitigation. While Transformer-based architectures have shown strong performance in many domains, their straightforward application to dense (i.e., pixel-level) regression tasks often yields suboptimal results. In particular, the patch size has a crucial impact on the model performance. In this work, we consider pixel-level attention schemes and show that the resulting models generally outperform those relying on larger patch sizes. However, pixel-level attention can be a prohibitively resource-intensive operation. For this reason, we conduct an extensive experimental study using efficient attention variants to identify favorable trade-offs between prediction quality and resource requirements, facilitating the practical deployment of the proposed models. In addition, we perform a comprehensive comparison with several well-established models in the field and show that, with suitable hyperparameter choices, Transformer-based architectures can outperform competing approaches. Our findings provide practical guidance for designing models for pixel-level regression tasks on medium-resolution satellite imagery, including canopy height and biomass estimation, soil moisture mapping, and yield forecasting.},
	number = {{arXiv}:2609.37809},
	publisher = {{arXiv}},
	author = {Ligensa, Sven and Pauls, Jan and Schrödter, Karsten and Fayad, Ibrahim and Gieseke, Fabian},
	urldate = {2026-10-02},
	date = {2026-09-29},
	eprinttype = {arxiv},
	eprint = {2609.37809 [cs.CV]},
	keywords = {Computer Science - Computer Vision and Pattern Recognition, Computer Science - Artificial Intelligence},
	file = {Full Text PDF:/Users/schwartz/Zotero/storage/Y7YFI7WE/Ligensa et al. - 2026 - Pixel-Level Transformers in Remote Sensing A Canopy Height Case Study.pdf:application/pdf;Snapshot:/Users/schwartz/Zotero/storage/AKF8CH8Y/2609.html:text/html},
}

@article{bourgoinGFC2020GlobalMap2026,
	title = {{GFC}2020: a global map of forest land use for year 2020 to support the {EU} Deforestation Regulation},
	volume = {18},
	issn = {1866-3508},
	url = {https://essd.copernicus.org/articles/18/1331/2026/},
	doi = {10.5194/essd-18-1331-2026},
	shorttitle = {{GFC}2020},
	abstract = {Remote sensing-based observations are used to map tree cover extent, estimate canopy height, detect disturbances, and classify land cover and land use. However, comprehensive global information on forest cover, capturing both physical characteristics and land use components as defined by the United Nations Food and Agriculture Organization ({FAO}), remains limited. Here, we present a harmonized and globally consistent map of forest presence or absence at 10 m spatial resolution for the year 2020, hereafter referred to as {GFC}2020. Our approach combines multiple spatial datasets, primarily derived from Earth observation ({EO}), to harness their complementary strengths within a transparent, flexible, and open science framework. {GFC}2020 maps 4562 million hectares (Mha) of forests globally, which is 9.5 \% more than the estimate from latest {FAO} Global Forest Resources Assessment ({FRA}) for 2020. {GFC}2020 forest area does not include 578 Mha of tree cover (11 \% of the global tree cover area) because these areas do not meet the height threshold or occur on agricultural or urban land. Conversely, around 0.6 \% (∼ 25 Mha) of the area classified as forest in {GFC}2020 is unstocked, due to forest management practices or natural disturbances such as fire. Based on the reinterpretation of a previously collected reference set of 21 752 sample units, {GFC}2020 achieves an overall accuracy of 91 \%, with a commission error of 18 \% and an omission error of 8 \% for forest. Improvements in {EO} products, such as better detection of trees in dry and open landscapes, distinguishing natural from human drivers of forest disturbance, mapping tree crops at high spatial resolution or identifying agroforestry systems, will contribute to enhancing future versions of {GFC}2020. The shift from tree cover to forest cover mapping is not only essential for ecological and climate-related applications but also provides new opportunities to support policy needs. {GFC}2020 is one of many tools to inform the deforestation risk assessments under supply chain oriented regulations such as the European Union's Deforestation Regulation ({EUDR}). Even though this map follows the {EUDR}'s definition of forest, it is a non-exclusive, non-mandatory, and not legally binding source. The data availability is as follows: {GFC}2020 (Bourgoin et al., 2024a, http://data.europa.eu/89h/e554d6fb-6340-45d5-9309-332337e5bc26) and the validation dataset (Colditz et al., 2025a, http://data.europa.eu/89h/8fbace34-a2fe-47b9-ad82-3e9226b7a9a6).},
	pages = {1331--1365},
	number = {2},
	journaltitle = {Earth System Science Data},
	publisher = {Copernicus {GmbH}},
	author = {Bourgoin, Clément and Verhegghen, Astrid and Carboni, Silvia and Ameztoy, Iban and Degreve, Lucas and Fritz, Steffen and Herold, Martin and Tsendbazar, Nandika and Lesiv, Myroslava and Achard, Frédéric and Colditz, René},
	urldate = {2026-10-05},
	date = {2026-02-19},
}

