	file = {Full Text PDF:/Users/schwartz/Zotero/storage/6JL42CH4/Ge et al. - 2022 - Improved Semisupervised UNet Deep Learning Model for Forest Height Mapping With Satellite SAR and Op.pdf:application/pdf;IEEE Xplore Abstract Record:/Users/schwartz/Zotero/storage/BPDLZ2W6/9814844.html:text/html},
