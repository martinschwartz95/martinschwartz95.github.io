\_eprint: https://doi.org/10.1080/10095020.2025.2555385},
	keywords = {remote sensing, Global Ecosystem Dynamics Investigation ({GEDI}), airborne laser scanning, ground surface estimation, light detection and ranging ({LiDAR})},
