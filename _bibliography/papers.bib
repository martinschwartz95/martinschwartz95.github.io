	file = {Sagang Takougoum et al. - 2024 - Unveiling spatial variations of high forest live b.pdf:/Users/schwartz/Zotero/storage/JKET9F6K/Sagang Takougoum et al. - 2024 - Unveiling spatial variations of high forest live b.pdf:application/pdf},
}

