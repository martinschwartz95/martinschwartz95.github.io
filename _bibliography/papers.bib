	urldate = {2025-02-13},
	date = {2024-07},
	langid = {english},
	note = {35 citations (Crossref/{DOI}) [2026-01-07]
31 citations (Semantic Scholar/{DOI}) [2026-01-06]},
	keywords = {Ecosystem services, Ecology},
