	langid = {english},
	keywords = {{DBH}, Forest inventory, Plantation forestry, Point cloud density, Poplar (Populus), Tree-level metrics},
	file = {Full Text PDF:/Users/schwartz/Zotero/storage/6SZYLWPZ/Battista et al. - 2026 - Impact of UAV flight parameters and acquisition context for canopy height and trunk diameter measure.pdf:application/pdf},
}
