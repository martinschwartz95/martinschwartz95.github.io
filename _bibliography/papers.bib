}

@article{kirschbaumModellingDynamicsForest2002,
	title = {Modelling C and N dynamics in forest soils with a modi®ed version of the {CENTURY} model},
	abstract = {The {CENTURY} model of soil organic matter turn-over developed by Parton and co-workers has been used successfully for grasslands to predict dynamics of C, N and other nutrients. It was tested here for decomposition of a range of forest litters and for N mineralisation in forest soils. Modi®cations to the {CENTURY} model were necessary to match model output to empirical ®ndings. These modi®cations included: (1) incorporation of additional woody litter pools (i.e. ®ne-wood and coarse-wood) (2) allowing the N content of soil organic matter ({SOM}) pools to vary (3) constraining N mineralisation and immobilisation to the active {SOM} pool (4) incorporation of a small ¯ux of mineral N to the resistant {SOM} pool (5) allowance of mycorrhizal uptake of N, and (6) re-formulation of temperature and moisture effects on decomposition. Other possible changes, such as giving greater ¯exibility to the critical N concentration for mineralisation, were tested but found not to improve model performance.},
