	note = {105 citations (Semantic Scholar/{DOI}) [2026-01-07]
95 citations (Crossref/{DOI}) [2026-01-07]
95 citations (Crossref/{DOI}) [2026-01-07]
95 citations (Crossref/{DOI}) [2026-01-07]},
	keywords = {Satellite imagery, Aerial photography, Case studies, {COST} action {FP}1001, Spaceborne data},
	file = {ScienceDirect Snapshot:/Users/schwartz/Zotero/storage/9CI9Y8GL/S0034425715301176.html:text/html;Version acceptée:/Users/schwartz/Zotero/storage/MJ63VGJA/Barrett et al. - 2016 - A questionnaire-based review of the operational us.pdf:application/pdf},
