@misc{sagangManagedForestsSupport2025,
	title = {Managed forests support higher carbon density and sequestration in the Congo basin},
	rights = {https://creativecommons.org/licenses/by/4.0/},
	url = {https://www.researchsquare.com/article/rs-7512165/v1},
	doi = {10.21203/rs.3.rs-7512165/v1},
	abstract = {Abstract
          
            Land-use drives forest loss and carbon emissions in the Congo basin, undermining its role in climate change mitigation. Here, we assess how aboveground live carbon ({AGC}) stocks and fluxes vary across land-use in the Congo basin rainforests by developing {AGC} density map for the year 2020 and integrating it with high-resolution forest cover loss data over 30 years (1990–2020) to estimate carbon emissions and removals. Our findings reveal higher forest integrity under managed disturbances, with logged forests having 7.53\% (range: 4.86\%–9.5\%) less {AGC} compared to old growth, unlike 50\% differences observed with slash-and-burn and other unmanaged disturbances. Unmanaged areas hold 50\% of the {AGC} storage, implying that much of the basin remains highly vulnerable to rapid carbon loss from unmanaged land-use. Overall, the basin remained a net {AGC} sink of -37.5 ± 4.29 Tg C yr
            − 1
            , dominated my 98\% removals from managed and intact forests within logging concessions (21.3 ± 2.39 Tg C yr
            − 1
            ) and protected areas (15.73 ± 2.24 Tg C yr
            − 1
            ), while unmanaged forests nearly remained carbon neutral. These findings underscore the critical need to integrate sustainable management strategies for unmanaged forests into climate mitigation frameworks such as {REDD} + to enhance carbon retention in the Congo basin.},
	publisher = {In Review},
	author = {Sagang, Le Bienfaiteur and Dalagnol, Ricardo and Georges, Stephanie and Favrichon, Samuel and Li, Shuang and Wagner, Fabien and Liu, Zhihua and Zhang, Dafeng and Ngomanda, Alfred and Medjibe, Vincent and Sonké, Bonaventure and Barbier, Nicolas and Ordway, Elsa and White, Lee and Saatchi, Sassan},
	urldate = {2025-10-06},
	date = {2025-10-01},
	langid = {english},
	note = {0 citations (Crossref/{DOI}) [2026-01-07]},
	file = {PDF:/Users/schwartz/Zotero/storage/8IQJLH4X/Sagang et al. - 2025 - Managed forests support higher carbon density and sequestration in the Congo basin.pdf:application/pdf},
}

@article{seidlChangesPlannedUnplanned2024,
	title = {Changes in planned and unplanned canopy openings are linked in Europe’s forests},
	volume = {15},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-024-49116-0},
	doi = {10.1038/s41467-024-49116-0},
	abstract = {Abstract
            Canopy openings are increasing in Europe’s forests, yet the contributions of anthropogenic and ecological agents of disturbance to this increase remain debated. Here we attribute the root cause of all stand-replacing canopy disturbances identified for Europe in the period 1986–2020 from Landsat data (417,000 km²), distinguishing between planned and unplanned canopy openings (i.e., disturbance by human land use versus by wind, bark beetles, and wildfire). We show that canopy openings by humans dominate the European forest disturbance regime, accounting for 82\% of the area disturbed. Both planned and unplanned canopy openings increased in the early 21st century (+24\% and +30\% relative to the late 20th century). Their changes are linked, with simultaneous increases in planned and unplanned canopy openings on 68\% of Europe’s forest area. We conclude that an important direction for tackling disturbance change in policy and management is to break the link between planned and unplanned canopy openings in Europe’s forests.},
	pages = {4741},
	number = {1},
	journaltitle = {Nature Communications},
	shortjournal = {Nat Commun},
	author = {Seidl, Rupert and Senf, Cornelius},
	urldate = {2025-10-06},
	date = {2024-06-04},
	langid = {english},
	note = {26 citations (Crossref/{DOI}) [2026-01-07]},
	file = {PDF:/Users/schwartz/Zotero/storage/UIHD7RRJ/Seidl et Senf - 2024 - Changes in planned and unplanned canopy openings are linked in Europe’s forests.pdf:application/pdf},
}

