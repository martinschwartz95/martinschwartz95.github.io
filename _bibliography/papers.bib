 and Guimarães Vieira, Ima Célia and Vilanova, Emilio and Zagt, Roderick and Baker, Timothy R. and Phillips, Oliver L.},
	urldate = {2026-01-28},
	date = {2025-09-25},
	langid = {english},
	note = {1 citations (Crossref/{DOI}) [2026-01-28]},
	file = {PDF:/Users/schwartz/Zotero/storage/CM7IC3NM/Esquivel-Muelbert et al. - 2025 - Increasing tree size across Amazonia.pdf:application/pdf},
