	keywords = {Deep learning, Canopy height, Montane forest, Multi-source remote sensing},
	file = {ScienceDirect Full Text PDF:/Users/schwartz/Zotero/storage/FEX8QC75/Luo et al. - 2025 - A framework for montane forest canopy height estimation via integrating deep learning and multi-sour.pdf:application/pdf},
