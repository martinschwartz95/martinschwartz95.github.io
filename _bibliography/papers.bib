	note = {41 citations (Semantic Scholar/{DOI}) [2026-01-07]
30 citations (Crossref/{DOI}) [2026-01-07]
41 citations (Semantic Scholar/{DOI}) [2026-01-06]},
	keywords = {{LiDAR}, climate change, biomass, datasets, neural networks},
	file = {Version soumise:/Users/schwartz/Zotero/storage/4CZQB6IM/Oehmcke et al. - 2022 - Deep learning based 3D point cloud regression for .pdf:application/pdf},
