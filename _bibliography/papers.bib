	eprint = {2407.08448 [cs]},
	note = {7 citations (Semantic Scholar/{arXiv}) [2026-01-07]
7 citations (Semantic Scholar/{arXiv}) [2026-01-06]},
	keywords = {Computer Science - Computer Vision and Pattern Recognition, Computer Science - Artificial Intelligence},
