@article{liDeepLearningEnables2023,
	title = {Deep learning enables image-based tree counting, crown segmentation, and height prediction at national scale},
	volume = {2},
	issn = {2752-6542},
	url = {https://doi.org/10.1093/pnasnexus/pgad076},
	doi = {10.1093/pnasnexus/pgad076},
	abstract = {Sustainable tree resource management is the key to mitigating climate warming, fostering a green economy, and protecting valuable habitats. Detailed knowledge about tree resources is a prerequisite for such management but is conventionally based on plot-scale data, which often neglects trees outside forests. Here, we present a deep learning-based framework that provides location, crown area, and height for individual overstory trees from aerial images at country scale. We apply the framework on data covering Denmark and show that large trees (stem diameter \&gt;10 cm) can be identified with a low bias (12.5\%) and that trees outside forests contribute to 30\% of the total tree cover, which is typically unrecognized in national inventories. The bias is high (46.6\%) when our results are evaluated against all trees taller than 1.3 m, which involve undetectable small or understory trees. Furthermore, we demonstrate that only marginal effort is needed to transfer our framework to data from Finland, despite markedly dissimilar data sources. Our work lays the foundation for digitalized national databases, where large trees are spatially traceable and manageable.},
	pages = {pgad076},
	number = {4},
	journaltitle = {{PNAS} Nexus},
	shortjournal = {{PNAS} Nexus},
	author = {Li, Sizhuo and Brandt, Martin and Fensholt, Rasmus and Kariryaa, Ankit and Igel, Christian and Gieseke, Fabian and Nord-Larsen, Thomas and Oehmcke, Stefan and Carlsen, Ask Holm and Junttila, Samuli and Tong, Xiaoye and d’Aspremont, Alexandre and Ciais, Philippe},
	urldate = {2023-08-26},
	date = {2023-04-01},
	note = {59 citations (Crossref/{DOI}) [2026-01-07]
71 citations (Semantic Scholar/{DOI}) [2026-01-06]},
