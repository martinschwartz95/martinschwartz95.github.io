@article{fanSiberianCarbonSink2023,
	title = {Siberian carbon sink reduced by forest disturbances},
	volume = {16},
	rights = {2022 The Author(s), under exclusive licence to Springer Nature Limited},
	issn = {1752-0908},
	url = {https://www.nature.com/articles/s41561-022-01087-x},
	doi = {10.1038/s41561-022-01087-x},
	abstract = {Siberian forests are generally thought to have acted as an important carbon sink over recent decades, but exposure to severe droughts and fire disturbances may have impacted their carbon dynamics. Limited available forest inventories mean the carbon balance remains uncertain. Here we analyse annual live and dead above-ground carbon changes derived from low-frequency passive microwave observations from 2010 to 2019. We find that during this period, the carbon balance of Siberian forests was close to neutral, with the forests acting as a small carbon sink of \$\$+ 0.02\_\{ + 0.01\}{\textasciicircum}\{ + 0.03\}\$\${PgC} yr−1. Carbon storage in dead wood increased, but this was largely offset by a decrease in live biomass. Substantial losses of live above-ground carbon are attributed to fire and drought, such as the widespread fires in northern Siberia in 2012 and extreme drought in eastern Siberia in 2015. These live above-ground carbon losses contrast with ‘greening’ trends seen in leaf area index over the same period, a decoupling explained by faster post-disturbance recovery of leaf area than live above-ground carbon. Our study highlights the vulnerability of large forest carbon stores in Siberia to climate-induced disturbances, challenging the persistence of the carbon sink in this region of the globe.},
	pages = {56--62},
	number = {1},
	journaltitle = {Nature Geoscience},
	shortjournal = {Nat. Geosci.},
	publisher = {Nature Publishing Group},
	author = {Fan, Lei and Wigneron, Jean-Pierre and Ciais, Philippe and Chave, Jérome and Brandt, Martin and Sitch, Stephen and Yue, Chao and Bastos, Ana and Li, Xin and Qin, Yuanwei and Yuan, Wenping and Schepaschenko, Dmitry and Mukhortova, Liudmila and Li, Xiaojun and Liu, Xiangzhuo and Wang, Mengjia and Frappart, Frédéric and Xiao, Xiangming and Chen, Jingming and Ma, Mingguo and Wen, Jianguang and Chen, Xiuzhi and Yang, Hui and van Wees, Dave and Fensholt, Rasmus},
	urldate = {2023-09-25},
	date = {2023-01},
	langid = {english},
	note = {99 citations (Semantic Scholar/{DOI}) [2026-01-07]
102 citations (Crossref/{DOI}) [2026-01-07]
99 citations (Semantic Scholar/{DOI}) [2026-01-06]
Number: 1},
	keywords = {Climate change, Forest ecology, Boreal ecology, Climate-change impacts, Fire ecology},
	file = {Full Text PDF:/Users/schwartz/Zotero/storage/ZAJUQX73/Fan et al. - 2023 - Siberian carbon sink reduced by forest disturbance.pdf:application/pdf},
