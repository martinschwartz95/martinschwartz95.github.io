0 citations (Semantic Scholar/{DOI}) [2026-01-06]},
	file = {PDF:/Users/schwartz/Zotero/storage/IQWCK7UT/Francini et al. - 2025 - Bridging spatio-temporal gaps in ALS data using Landsat time series and forest disturbance-recovery.pdf:application/pdf},
