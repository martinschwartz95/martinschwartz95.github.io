@article{mullissaLUCASentinel1SARBased2024,
	title = {{LUCA}: A Sentinel-1 {SAR}-Based Global Forest Land Use Change Alert},
	volume = {16},
	rights = {http://creativecommons.org/licenses/by/3.0/},
	issn = {2072-4292},
