@article{fareedAbovegroundBiomassModeling2025,
	title = {Aboveground biomass modeling using simulated Global Ecosystem Dynamics Investigation ({GEDI}) waveform {LiDAR} and forest inventories in Amazonian rainforests},
	volume = {578},
