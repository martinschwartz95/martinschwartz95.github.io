@article{ni-meisterEnhancingAbovegroundBiomass2025,
	title = {Enhancing aboveground biomass density estimates in tropical forests using {GEDI} waveform data},
	volume = {12},
	issn = {2666-0172},
	url = {https://www.sciencedirect.com/science/article/pii/S2666017225000926},
	doi = {10.1016/j.srs.2025.100286},
	abstract = {Effective implementation of {REDD}+ (Reducing Emissions from Deforestation and Forest Degradation) activities requires high-resolution, large-scale accurate estimates of aboveground biomass density ({AGBD}). The Global Ecosystem Dynamics Investigation ({GEDI}) mission provides the unmatched sampling density of vertical vegetation structures and biomass estimates in temperate and tropical forests between 51.60 N \& S latitude. However, with large uncertainties in current {GEDI} biomass models and the need for intensive field data for calibration, this study applies a generalized lidar waveform-based biomass model to produce regional scale biomass using Land Vegetation and Ice Sensor ({LVIS}) data and 2) nationally using spaceborne {GEDI} observations in tropical forest in Gabon, Central Africa with minimum calibration. It tests two allometric relationship input parameters derived from global and local vegetation structure datasets. The model demonstrates consistent accuracy, achieving {RMSE} = 40.38 Mg ha−1, normalized {RMSE} = 0.15, and R2 = 0.91 at the hectare level compared to field measurements. It outperforms two existing biomass products derived from {LVIS} and small-footprint lidar data as well as the {GEDI} L4A product itself. Incorporating wood density improves model performance, reducing {RMSE} from 57.66 Mg ha−1 to 40.38 Mg ha−1, {NRMSE} from 0.21 to 0.15, and increasing R2 from 0.82 to 0.91. The model performs better with {LVIS} data than with {GEDI} data, likely due to temporal differences in data collection, sensor noise, and {GEDI} geolocation errors. The results demonstrate the potential use of this generalized model to enhance biomass estimation in tropical forests using satellite data, supporting {REDD} + initiatives.},
	pages = {100286},
	journaltitle = {Science of Remote Sensing},
	shortjournal = {Science of Remote Sensing},
	author = {Ni-Meister, Wenge and Rojas, Alejandro and Grant, Ian},
	urldate = {2025-09-22},
	date = {2025-12-01},
	note = {0 citations (Crossref/{DOI}) [2026-01-07]
0 citations (Semantic Scholar/{DOI}) [2026-01-06]},
	keywords = {{GEDI}, {REDD}+, Biomass density model, Lidar waveforms},
