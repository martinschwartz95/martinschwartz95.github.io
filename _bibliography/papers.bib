	note = {2 citations (Semantic Scholar/{DOI}) [2026-01-07]
5 citations (Crossref/{DOI}) [2026-01-07]
2 citations (Semantic Scholar/{DOI}) [2026-01-06]},
	keywords = {Landsat, Forest structure, Gradient nearest neighbor, Imputation, National Forest Inventories, Temperate Rainforest},
	file = {ScienceDirect Full Text PDF:/Users/schwartz/Zotero/storage/UL54DBRH/Lamping et al. - 2025 - Moderate-resolution mapping of aboveground biomass stocks, forest structure, and composition in coas.pdf:application/pdf;ScienceDirect Snapshot:/Users/schwartz/Zotero/storage/TVVLYWR6/S0378112725000842.html:text/html},
