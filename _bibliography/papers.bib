	urldate = {2023-09-25},
	date = {2021-05},
	langid = {english},
	note = {271 citations (Crossref/{DOI}) [2026-01-07]
Number: 5},
	keywords = {Climate change, Tropical ecology, Forest ecology, Climate-change ecology},
