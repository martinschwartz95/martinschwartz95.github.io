@article{vanweesGlobalBiomassBurning2022,
	title = {Global Biomass Burning Fuel Consumption and Emissions at 500 m Spatial Resolution Based on the Global Fire Emissions Database ({GFED})},
	volume = {15},
	issn = {1991-9603},
	doi = {10.5194/gmd-15-8411-2022},
	abstract = {Abstract. In fire emission models, the spatial resolution of both the modelling framework and the satellite data used to quantify burned area can have considerable impact on emission estimates. Consideration of this sensitivity is especially important in areas with heterogeneous land cover and fire regimes and when constraining model output with field measurements. We developed a global fire emissions model with a spatial resolution of 500{\textbackslash},m using {MODerate} resolution Imaging Spectroradiometer ({MODIS}) data. To accommodate this spatial resolution, our model is based on a simplified version of the Global Fire Emissions Database ({GFED}) modelling framework. Tree mortality as a result of fire, i.e. fire-related forest loss, was modelled based on the overlap between 30{\textbackslash},m forest loss data and {MODIS} burned area and active fire detections. Using this new 500{\textbackslash},m model, we calculated global average carbon emissions from fire of 2.1{\textbackslash}pm0.2 ({\textbackslash}pm1σ interannual variability, {IAV}){\textbackslash},Pg{\textbackslash},C{\textbackslash},yr-1 during 2002– 2020. Fire-related forest loss accounted for 2.6{\textbackslash}pm0.7{\textbackslash},\% (uncertainty range =1.9{\textbackslash},\%– 3.3{\textbackslash},\%) of global burned area and 24{\textbackslash}pm6{\textbackslash},\% (uncertainty range =16{\textbackslash},\%– 31{\textbackslash},\%) of emissions, indicating that fuel consumption in forest fires is an order of magnitude higher than the global average. Emissions from the combustion of soil organic carbon ({SOC}) in the boreal region and tropical peatlands accounted for 13{\textbackslash}pm4{\textbackslash},\% of global emissions. Our global fire emissions estimate was higher than the 1.5{\textbackslash},Pg{\textbackslash},C{\textbackslash},yr-1 from {GFED}4 and similar to 2.1{\textbackslash},Pg{\textbackslash},C{\textbackslash},yr-1 from {GFED}4s. Even though {GFED}4s included more burned area by accounting for small fires undetected by the {MODIS} burned area mapping algorithm, our emissions were similar to {GFED}4s due to higher average fuel consumption. The global difference in fuel consumption could mainly be explained by higher {SOC} emissions from the boreal region as constrained by additional measurements. The higher resolution of the 500{\textbackslash},m model also contributed to the difference by improving the simulation of landscape heterogeneity and reducing the scale mismatch in comparing field measurements to model grid cell averages during model calibration. Furthermore, the fire-related forest loss algorithm introduced in our model led to more accurate and widespread estimation of high-fuel-consumption burned area. Recent advances in burned area detection at resolutions of 30{\textbackslash},m and finer show a substantial amount of burned area that remains undetected with 500{\textbackslash},m sensors, suggesting that global carbon emissions from fire are likely higher than our 500{\textbackslash},m estimates. The ability to model fire emissions at 500{\textbackslash},m resolution provides a framework for further improvements with the development of new satellite-based estimates of fuels, burned area, and fire behaviour, for use in the next generation of {GFED}.},
	pages = {8411--8437},
	number = {22},
	journaltitle = {Geoscientific Model Development},
	author = {Van Wees, Dave and Van Der Werf, Guido R. and Randerson, James T. and Rogers, Brendan M. and Chen, Yang and Veraverbeke, Sander and Giglio, Louis and Morton, Douglas C.},
	urldate = {2023-07-18},
	date = {2022-11},
	note = {78 citations (Crossref/{DOI}) [2026-01-07]},
}

