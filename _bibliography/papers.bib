	author = {Cao, Bowen and Yu, Le and Naipal, Victoria and Ciais, Philippe and Li, Wei and Zhao, Yuanyuan and Wei, Wei and Chen, Die and Liu, Zhuang and Gong, Peng},
	urldate = {2020-12-09},
	date = {2020-10-20},
	note = {5 citations (Crossref/{DOI}) [2026-01-07]
5 citations (Crossref/{DOI}) [2026-01-07]},
