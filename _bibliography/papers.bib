@thesis{sagarMultisourceForestInventory2023,
	title = {Multisource Forest Inventory : a Generic and Flexible Tool for Forest Resource Estimation and Mapping at a Fine Scale},
	url = {https://hal.univ-lorraine.fr/tel-04688791},
	shorttitle = {Multisource Forest Inventory},
	abstract = {Multisource Forest Inventory methods aim at combining field inventory data with auxiliary data from remote sensing and/or maps to downscale estimates while controlling precision. Those methods can be developed under different modelling and estimation frameworks. This thesis focused on the development of such methods for downscaling French National Forest Inventory estimates. Owing to their multivariate capacities, non-parametric k-nearest neighbour's models were used. The main objective of this thesis was to evaluate up to which scale auxiliary data allow to downscale estimates, and to propose methods to optimise the small area estimation ({SAE}) domains. A secondary objective was to develop method to evaluate the reliability of model predictions at pixel level to support high resolution mapping of forest attributes. The auxiliary data considered in the thesis were mostly 3D data from airborne laser scanning ({ALS}) and photogrammetry ({DAP}), and optical data from high resolution satellites images and forest map. Based on these objectives, four studies were conducted in four chapters. In Chapter I, a flexible multi-scale model-assisted approach for {SAE} of forest attributes at the municipality or group of municipalities' level was proposed. The scaling framework was controlled by a minimum number of {NFI} plots per computation domain and a maximum error threshold. The study was conducted over Sologne and Orleans forests, representing 157 municipalities, for volume and basal area. When the target estimation error was set to 10\%, the approach yielded 23 estimated grouped domains, with an average estimation error below 7.7\% for both attributes. It increased to 80 domains with an average error of 15.1\% when the error threshold was set to 50\%. The results provided users with the flexibility to improve the precision of the estimates while maintaining a balanced spatial scale. In Chapter {II}, a convex hull method was used to identify the proportion of extrapolated predictions in model-based map products, and to analyse the impact of various sampling efforts on model precision and extrapolation levels. The method was applied to management inventory data over Mouterhouse forest, in North-Est France. Results showed that the model precision stabilized quickly with small sampling effort, but the extrapolation level remained high. Extrapolation level stabilised at higher sampling intensity. The method serves as a valuable tool for building accuracy maps and enables the identification of areas that requires additional sampling effort. In Chapter {III}, a model-based approach was developed to produce high resolution maps with reliability assessment at pixel level. The method relies on bootstrapped predictions and extrapolation. Tested over Sologne and Orleans forests, result showed that a minimum of 84\% of the predictions were highly reliable. The performance of both {ALS} and {DAP} were similar, offering the possibility of utilizing cost-effective and frequently updated {DAP} for monitoring purposes. The high resolution outputs were significant for forest management and decision making purposes. In Chapter {IV}, a model-based approach was used for {SAE} of forest attributes impacted by bark-beetle outbreak in the Vosges forests. The methods combined maps generated using the methodology developed in Chapter {III} with anomaly map derived from the {ForDead} method. Two maps were evaluated: a general one covering the entire area and a specific one generated for spruce and fir. In 2021-2022 {ForDead} identified 1,139 ha of outbreaks in spruce and fir dominated stands. Our method evaluated the amount of volume impacted to 494,213 m³ (± 2.2\%) with the general model and to 505,401 m³ (± 2.7\%) with the specific model. On average, the impacted volume was 67 m3/ha higher than the population mean, indicating that mature stands were primarily impacted. Future research will address the uncertainties associated with surface detection and their integration in resource estimations.},
	institution = {Université de Lorraine},
	type = {phdthesis},
	author = {Sagar, Ankit},
	urldate = {2025-01-16},
	date = {2023-09-21},
	langid = {english},
	file = {Full Text PDF:/Users/schwartz/Zotero/storage/LPDCLWQL/Sagar - 2023 - Multisource Forest Inventory  a Generic and Flexible Tool for Forest Resource Estimation and Mappin.pdf:application/pdf},
}

@article{besicRemotesensingbasedForestCanopy2025,
	title = {Remote-sensing-based forest canopy height mapping: some models are useful, but might they provide us with even more insights when combined?},
	volume = {18},
	issn = {1991-959X},
	url = {https://gmd.copernicus.org/articles/18/337/2025/},
	doi = {10.5194/gmd-18-337-2025},
	shorttitle = {Remote-sensing-based forest canopy height mapping},
	abstract = {The development of high-resolution mapping models for forest attributes based on remote sensing data combined with machine or deep learning techniques has become a prominent topic in the field of forest observation and monitoring. This has resulted in the availability of multiple, sometimes conflicting, sources of information, but, at face value, it also makes it possible to learn about forest attribute uncertainty through the joint interpretation of multiple models. This article seeks to endorse the latter by utilizing the Bayesian model averaging approach to diagnose and interpret the differences between predictions from different models. The predictions in our case are forest canopy height estimations for metropolitan France arising from five different models. An independent reference dataset, containing four different definitions of forest height (dominant, mean, maximum, and Lorey's) was established based on around 5500 plots of the French National Forest Inventory ({NFI}), distributed across the entire area of interest. In this study, we evaluate models with respect to their probabilities of correctly predicting measurements or estimations obtained from {NFI} plots, highlighting the spatial variability in respective model probabilities across the study area. We observed significant variability in these probabilities depending on the forest height definition used, implying that the different models inadvertently predict different types of canopy height. We also present the respective inter-model and intra-model variance estimations, enabling us to grasp where the employed models have comparable contributions but contrasting predictions. We show that topography has an important impact on the models spread. Moreover, we observed that the forest stand vertical structure, the dominant tree species, and the type of forest ownership systematically emerge as statistically significant factors influencing the model divergences. Finally, we observed that the fitted higher-order mixtures, which enabled the presented analyses, do not necessarily reduce bias or prevent the saturation of the predicted heights observed in the individual models.},
	pages = {337--359},
	number = {2},
	journaltitle = {Geoscientific Model Development},
	publisher = {Copernicus {GmbH}},
	author = {Besic, Nikola and Picard, Nicolas and Vega, Cédric and Bontemps, Jean-Daniel and Hertzog, Lionel and Renaud, Jean-Pierre and Fogel, Fajwel and Schwartz, Martin and Pellissier-Tanon, Agnès and Destouet, Gabriel and Mortier, Frédéric and Planells-Rodriguez, Milena and Ciais, Philippe},
	urldate = {2025-01-22},
	date = {2025-01-22},
	note = {8 citations (Crossref/{DOI}) [2026-01-07]
10 citations (Semantic Scholar/{DOI}) [2026-01-06]},
	file = {Full Text PDF:/Users/schwartz/Zotero/storage/C9TIL5FH/Besic et al. - 2025 - Remote-sensing-based forest canopy height mapping some models are useful, but might they provide us.pdf:application/pdf},
}

