}

@article{cao30meterTerraceMapping2020,
	title = {A 30-meter terrace mapping in China using Landsat 8 imagery and digital elevation model based on the Google Earth Engine},
	issn = {1866-3508},
	url = {https://essd.copernicus.org/preprints/essd-2020-157/},
	doi = {https://doi.org/10.5194/essd-2020-157},
	abstract = {{\textless}p{\textgreater}{\textless}strong{\textgreater}Abstract.{\textless}/strong{\textgreater} The construction of terraces is a key soil conservation practice on agricultural land in China, providing multiple valuable ecosystem services. Accurate spatial information on terraces is needed for both management and research. In this study, the first 30\&thinsp;m resolution terracing map of the entire territory of China is produced by a supervised pixel-based classification using multi-source and multi-temporal data based on the Google Earth Engine ({GEE}) platform. We extracted time-series spectral features and topographic features from Landsat 8 images and the Shuttle Radar Topography Mission digital elevation model ({SRTM} {DEM}) data, classifying cropland area (cultivated land of Globeland30) into terraced and non-terraced type through a random forest classifier. The overall accuracy and kappa coefficient were evaluated by 10875 test samples and achieved values of 94\&thinsp;\% and 0.72, respectively. The classification performed best in the Loess Plateau and southwestern China, where terraces are most numerous. Some northeastern, central eastern and southern area had relatively high uncertainty. Typical errors in the mapping results from the sloping cropland (non-terrace cropland with a slope of ≥\&thinsp;5°), low-slope terraces, and non-crop vegetation. Terraces are widely distributed in China and the total terraced area was estimated to be 53.55\&thinsp;Mha (i.e., 26.43\&thinsp;\% of China's cropland area) by pixel counting ({PC}) method and 58.46\&thinsp;±\&thinsp;2.99\&thinsp;Mha (i.e., 28.85\&thinsp;\%\&thinsp;±\&thinsp;1.48\&thinsp;\% of China's cropland area) by error matrix-based model-assisted estimation ({EM}) method. Elevation and slope were identified as the main features in the terrace/non-terrace classification, and multi-temporal spectral features (such as percentiles of {NDVI}, {TIRS}2, {BSI}) were also essential. Terraces are more challenging to identify than other land use types because of the intra-class feature heterogeneity, inter-class feature similarity and fragmented patches, which should be the focus of future research. Our terrace mapping algorithm can be used to map large-scale terraces in other regions globally, and our terrace map will serve as a landmark for studies on multiple ecosystem services assessments including erosion control, carbon sequestration, and biodiversity conservation. The China terrace map is available to the public at {\textless}a href=" https://doi.org/10.5281/zenodo.3895585"target="\_blank"{\textgreater}https://doi.org/10.5281/zenodo.3895585{\textless}/a{\textgreater} (Cao et al., 2020).{\textless}/p{\textgreater}},
	pages = {1--35},
	journaltitle = {Earth System Science Data Discussions},
