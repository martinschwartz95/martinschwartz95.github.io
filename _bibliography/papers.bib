@online{wielgoszSegmentAnyTreeV2ScalingTransformerBased2026,
	title = {{SegmentAnyTreeV}2: Scaling Transformer-Based Tree Instance Segmentation Across Sensors, Platforms, and Forests},
	url = {https://arxiv.org/abs/2606.08206v2},
	shorttitle = {{SegmentAnyTreeV}2},
	abstract = {We present {SegmentAnyTreeV}2, a sensor- and platform-agnostic framework for semantic and instance segmentation of forest point clouds. The model combines a serialization-based Point Transformer v3 backbone with a lightweight semantic head and a tree-focused cross-attention mask decoder. Semantic predictions restrict instance decoding to tree-class voxels, while instance-aware query initialization, one-to-many seed supervision, and asymmetric mask scoring improve separation in dense and structurally complex stands. We further introduce {FOR}-instance v3, an expanded benchmark comprising 427 scenes and 26,496 annotated trees across diverse biomes, forest structures, and {LiDAR} platforms. On the {FOR}-{instanceV}2 test split, {SegmentAnyTreeV}2 achieves 90.5\% precision, 80.2\% recall, 85.0\% F1, 90.7\% coverage, and 87.6\% semantic {mIoU}, outperforming previous learning-based methods in both instance detection and mask completeness. Zero-shot evaluation on independent sites further demonstrates strong cross-domain generalization.},
	titleaddon = {{arXiv}.org},
	author = {Wielgosz, Maciej and Puliti, Stefano and Astrup, Rasmus},
	urldate = {2026-06-25},
	date = {2026-06-06},
	langid = {english},
	file = {Full Text PDF:/Users/schwartz/Zotero/storage/HUU9T8PA/Wielgosz et al. - 2026 - SegmentAnyTreeV2 Scaling Transformer-Based Tree Instance Segmentation Across Sensors, Platforms, an.pdf:application/pdf},
}

@online{xiangForestFormer3DUnifiedFramework2025,
	title = {{ForestFormer}3D: A Unified Framework for End-to-End Segmentation of Forest {LiDAR} 3D Point Clouds},
	url = {https://arxiv.org/abs/2506.16991v2},
	shorttitle = {{ForestFormer}3D},
	abstract = {The segmentation of forest {LiDAR} 3D point clouds, including both individual tree and semantic segmentation, is fundamental for advancing forest management and ecological research. However, current approaches often struggle with the complexity and variability of natural forest environments. We present {ForestFormer}3D, a new unified and end-to-end framework designed for precise individual tree and semantic segmentation. {ForestFormer}3D incorporates {ISA}-guided query point selection, a score-based block merging strategy during inference, and a one-to-many association mechanism for effective training. By combining these new components, our model achieves state-of-the-art performance for individual tree segmentation on the newly introduced {FOR}-{instanceV}2 dataset, which spans diverse forest types and regions. Additionally, {ForestFormer}3D generalizes well to unseen test sets (Wytham woods and {LAUTx}), showcasing its robustness across different forest conditions and sensor modalities. The {FOR}-{instanceV}2 dataset and the {ForestFormer}3D code are publicly available at https://bxiang233.github.io/{FF}3D/.},
	titleaddon = {{arXiv}.org},
	author = {Xiang, Binbin and Wielgosz, Maciej and Puliti, Stefano and Král, Kamil and Krůček, Martin and Missarov, Azim and Astrup, Rasmus},
	urldate = {2026-06-25},
	date = {2025-06-20},
	langid = {english},
	file = {Full Text PDF:/Users/schwartz/Zotero/storage/UZ34NZYK/Xiang et al. - 2025 - ForestFormer3D A Unified Framework for End-to-End Segmentation of Forest LiDAR 3D Point Clouds.pdf:application/pdf},
}

@article{pazRecentClimateChange2025,
	title = {Recent climate change reduced Spanish forests' carbon sink capacity},
	rights = {{CC} {BY} Attribution 4.0 International},
	url = {https://eartharxiv.org/repository/view/10795/},
	abstract = {Forests play a crucial role as carbon sinks and are central to climate mitigation strategies, yet their long-term reliability in this function is increasingly uncertain under climate change. Using deep learning techniques on a multi-source dataset—combining multi-spectral satellite data, airborne laser scanning, and ground-based measurements—we produced the most up-to-date high-resolution maps of woody carbon storage in continental Spain on a yearly basis from 2017 to 2024. Our analysis revealed substantial forest carbon losses, with Spanish forests and woodlands functioning as a net carbon source during this period, losing approximately 12\% of their biomass carbon stocks, with the sharpest decline occurring during 2022 following the most intense drought of the century. Eucalyptus plantations and conifer forests experienced the greatest relative losses, 30\% and 22\% respectively, while low-density woodlands and agroforestry systems showed the greater resilience, with woody carbon stocks dropping only 5{\textbackslash}\% in these areas. Our results support structural overshoot, where periods of favorable growing conditions promote vegetation growth that subsequently becomes vulnerable during drier conditions. Specifically, large rainfall and cooler summer temperatures were strongly correlated with subsequent time-lagged carbon losses. These findings reveal a critical challenge for climate policy as forest mitigation potential is hampered by climate change impacts, especially in Mediterranean regions where drought intensity is increasing. This highlights the urgent need to align adaptation and mitigation policies to enhance forest resilience and its long-term climate mitigation capacity.},
	publisher = {{EarthArXiv}},
	author = {Paz, Diego Bengochea and Rey, Ana and Zavala, Miguel Ángel and Araújo, Miguel B.},
	urldate = {2026-07-03},
	date = {2025-11-13},
	langid = {english},
	file = {Full Text PDF:/Users/schwartz/Zotero/storage/22J6NGUH/Paz et al. - 2025 - Recent climate change reduced Spanish forests' carbon sink capacity.pdf:application/pdf},
}

@article{cummingProtectedAreaManagement2026,
	title = {Protected area management has significant spillover effects on vegetation},
	volume = {650},
	rights = {2025 The Author(s)},
	issn = {1476-4687},
	url = {https://www.nature.com/articles/s41586-025-09837-8},
	doi = {10.1038/s41586-025-09837-8},
	abstract = {The Kunming–Montreal Global Biodiversity Framework calls for rapid global expansion of protected areas in response to ongoing biodiversity loss and ecosystem degradation1. One of its strongest selling points is the benefits protected areas provide to adjacent human communities2,3. However, little attention has been paid to how policy and management can support such benefits. Here, to address this gap, I explored influences on the effect sizes of vegetation spillovers from a candidate 12,513 Australian protected areas, defining spillovers as the difference in vegetation outside a protected area that occurs as a consequence of the existence of the protected area4. In 2020, 71\% (2,189) out of the 3,063 protected areas for which full analysis was possible had a positive spillover effect of 0.1 or greater on at least 1 of 10 vegetation cover classes. Many protected area types were significant predictors of spillover magnitude. The covariance explained by protected area type with local and contextual variables was 14\%, suggesting that internal management moderates adjacent locations. These findings highlight the potential to include spillover effects explicitly in global policy frameworks and suggest a pathway to an empirical basis for monitoring and accounting schemes that support biodiversity conservation and ecosystem service provision adjacent to protected areas.},
	pages = {642--651},
	number = {8102},
	journaltitle = {Nature},
	publisher = {Nature Publishing Group},
	author = {Cumming, Graeme S.},
	urldate = {2026-07-03},
	date = {2026-02},
	langid = {english},
	keywords = {Ecosystem services, Conservation biology},
	file = {Full Text PDF:/Users/schwartz/Zotero/storage/LHAWJXVD/Cumming - 2026 - Protected area management has significant spillover effects on vegetation.pdf:application/pdf},
}

@article{bengocheapazProtectedAreasAre2026,
	title = {Protected areas are effective at conserving carbon sink capacity even in fire-prone terrestrial ecosystems},
	volume = {21},
	issn = {1748-9326},
	url = {https://doi.org/10.1088/1748-9326/ae3783},
	doi = {10.1088/1748-9326/ae3783},
	abstract = {Recent studies have claimed that protected areas ({PAs}) in fire-prone landscapes may undermine forest carbon conservation by creating high fuel load concentrations, challenging the role of {PA} expansion as a climate change mitigation strategy. We tested this hypothesis using above-ground biomass trends from 2017 to 2024 across Spain, a region experiencing intensifying drought and extreme events as well as increasing wildfire pressure. Using statistical matching techniques that control for initial biomass conditions and climate exposure, we compared live biomass carbon conservation performance between {PAs} and non-{PAs}. {PAs} significantly outperformed non-{PA} counterparts, showing better live biomass carbon conservation in 70\% of biomass-matched comparisons and maintaining this advantage in 59\% of climate-controlled comparisons-representing a statistically significant 9\% advantage over the null hypothesis. We find that most strict {PAs} (National Parks) have an enhanced effectiveness, showing better performance in carbon conservation in 85\% of biomass-controlled and 68\% of climate-controlled matches, respectively. This advantage demonstrates that protection status itself, not merely favorable location, can drive enhanced carbon conservation. Our results provide empirical support for {PA} expansion as an effective climate change mitigation strategy.},
	pages = {044007},
	number = {4},
	journaltitle = {Environmental Research Letters},
	shortjournal = {Environ. Res. Lett.},
	publisher = {{IOP} Publishing},
	author = {Bengochea Paz, Diego and Rey, Ana and Zavala, Miguel Á and Araújo, Miguel B},
	urldate = {2026-07-03},
	date = {2026-02},
	langid = {english},
	file = {IOP Full Text PDF:/Users/schwartz/Zotero/storage/GEIJK7L4/Bengochea Paz et al. - 2026 - Protected areas are effective at conserving carbon sink capacity even in fire-prone terrestrial ecos.pdf:application/pdf},
}

@article{arazaComparingGlobalAboveground,
	title = {Comparing global aboveground biomass maps: Trends, Accuracy and Ways forward},
	abstract = {Global aboveground biomass ({AGB}) maps have expanded rapidly in number, resolution and methodology; increasing the need for consistent inter-comparison and validation to understand trends and improvements over time. We compiled 33 global and pantropical {AGB} maps published from 2007 to 2026 and analyzed 21 products, including 19 open-access datasets, using a multi-temporal and multi-resolution independent reference dataset ({AGBref} ). We found a progression from coarse {IPCC}-based maps at 10–55 km resolution, to statistical-empirical maps. More recent developments include long time-series products products, and deep learning maps that produce biomass estimates at 10 m resolution. Validation against {AGBref} at 10 km resolution shows measurable improvement of maps through time, particularly reduced overestimation in low-biomass areas ({\textless}50 Mg ha-1). Though less pronounced as before, biomass maps still underestimate high-biomass forests, especially above approximately 300–350 Mg ha-1. Harmonized maps (fusing existing products) and maps using physically based biomass retrievals generally showed lower bias and more stable precision ({RMSD}) than {IPCC}-based products, while map updating and versioning, led to improved agreement with reference data. Using {ALS}-derived reference biomass maps, the assessment of local spatial heterogeneity for higher resolution maps {CCI} Biomass, {JPL}, {CTrees}, Planet Labs and Weber et al., products highlighted the limited capability of current maps to represent local biomass patterns. Some maps reproduced local mean biomass and broad patterns but smoothed finescale heterogeneity, whereas others retained more variance but showed weaker mean and pattern agreement. Overall, the results point to a broader community improvement in global {AGB} mapping, but also show that further progress depends on sustained investment in quality reference data, transparent product versioning and user-informed assessment frameworks.},
	author = {Araza, Arnan and Urbazaev, Mikhail and Avitabile, Valerio and Quegan, Shaun and Anderson, Christopher and Carvalhais, Nuno and Carter, Sarah and Ciais, Philippe and Duncanson, Laura and Gibbs, David and Harris, Nancy and Hein, Lars and Hunka, Neha and Labriere, Nicolas and Lucas, Richard and Saatchi, Sassan and Santoro, Maurizio and Stolle, Fred and Weber, Manuel and Herold, Martin},
	langid = {english},
	file = {PDF:/Users/schwartz/Zotero/storage/4P3R34TA/Araza et al. - Comparing global aboveground biomass maps Trends, Accuracy and Ways forward.pdf:application/pdf},
}

@article{liDeepLearningTree2026,
	title = {Deep learning tree and forest biomass from sub-meter resolution optical imagery},
	volume = {345},
	issn = {0034-4257},
	url = {https://www.sciencedirect.com/science/article/pii/S0034425726003093},
	doi = {10.1016/j.rse.2026.115539},
	abstract = {Computer vision algorithms have been widely employed for characterizing visually interpretable forest and tree structures such as individual tree crowns from high-resolution optical imagery. However, the learning of more complex and integrated variables, including forest biomass, remains challenging. Consequently, above-ground biomass ({AGB}) is traditionally estimated from structural measures of trees, which require Light Detection and Ranging ({LiDAR}) data that is not always readily available. Here, we evaluate the capacity of convolutional neural networks ({CNN}) to interpret spatial semantic patterns in optical {RGB} images to directly estimate forest {AGB}. Trained with forest inventory plots, the {CNN} model shows evidence of learning via implicitly interpreting the composition of biomass at tree level, differing from traditional approaches reliant on conversions of aggregated parameters. We compare the proposed method against benchmark approaches for biomass estimation at plot and tree levels. We further propose a learnable allometric model based on smooth min-max networks, which allows for flexible adjustments of allometric relationships between field-measured biomass and remotely detected tree features, such as {LiDAR}-derived tree height. Our experiments demonstrate that the {CNN} model yields arguably high performance (R2 = 0.71) without tree height information, approaching a random forest model with access to tree height (R2 = 0.8). {CNN}'s ability to infer biomass directly from optical high-resolution images, down to the level of single pixels of the imagery used, enables a new level of flexibility in spatial scaling. Furthermore, when optical images are available at a higher temporal frequency than {LiDAR} data, {CNNs} offer enhanced flexibility in temporal scaling.},
	pages = {115539},
	journaltitle = {Remote Sensing of Environment},
	shortjournal = {Remote Sensing of Environment},
	author = {Li, Sizhuo and Brandt, Martin and Tong, Xiaoye and Oehmcke, Stefan and Igel, Christian and Reiner, Florian and Gieseke, Fabian and Nord-Larsen, Thomas and Fensholt, Rasmus and Chave, Jerome and Ciais, Philippe},
	urldate = {2026-07-30},
	date = {2026-11-01},
	keywords = {Remote sensing, Forest biomass, Convolutional neural networks, Image regression, Smooth min-max network},
	file = {ScienceDirect Full Text PDF:/Users/schwartz/Zotero/storage/LKNLF3IX/Li et al. - 2026 - Deep learning tree and forest biomass from sub-meter resolution optical imagery.pdf:application/pdf;ScienceDirect Snapshot:/Users/schwartz/Zotero/storage/MSVVR44F/S0034425726003093.html:text/html},
}

@article{mugabowindekweRemoteSensingBasedSolution2026,
	title = {A Remote Sensing-Based Solution for National Scale Tree Counting},
	volume = {6},
	url = {https://spj.science.org/doi/10.34133/remotesensing.0970},
	doi = {10.34133/remotesensing.0970},
	abstract = {Accurate tree counts are crucial for global restoration efforts, given the need for progress tracking and effective evaluation of tree planting and survival. However, conventional methods often fail to accurately capture tree counts at large scales, particularly in landscapes outside forests. We developed a deep learning approach for estimating tree counts from satellite imagery, nationally, across Rwanda and Tanzania in East Africa in 2019. We used a 20-band composite image composed of bands from {PlanetScope}, Sentinel-1, and Sentinel-2 as input, and estimated a total count of about 5.2 billion trees across the 2 countries. Only about 48.8\% of the estimated tree counts fall within the {WorldCover} “tree cover” class, with the remainder being distributed across nonforest landscapes. Our work provides information on tree counts at the national scale in Rwanda and Tanzania using low-cost and freely available satellite images, which can guide the planning and optimization of resource allocation for tree restoration efforts at national scales.},
	pages = {0970},
	journaltitle = {Journal of Remote Sensing},
	publisher = {American Association for the Advancement of Science},
	author = {Mugabowindekwe, Maurice and Gominski, Dimitri and Reiner, Florian and Tong, Xiaoye and Ciais, Philippe and Nyandwi, Elias and Gasangwa, Ivan and Hategekimana, Yves and John, Elikana and Main, Russell and Laurin, Gaia Vaglio and Fensholt, Rasmus and Brandt, Martin},
	urldate = {2026-08-24},
	date = {2026-08-18},
	file = {Full Text PDF:/Users/schwartz/Zotero/storage/9IGBVFLK/Mugabowindekwe et al. - 2026 - A Remote Sensing-Based Solution for National Scale Tree Counting.pdf:application/pdf},
}

@article{ballGeospatialFoundationModels2026,
	title = {Geospatial foundation models enable data-efficient tree species mapping in temperate mountain forests},
	volume = {14},
	issn = {2666-0172},
	url = {https://www.sciencedirect.com/science/article/pii/S2666017226001045},
	doi = {10.1016/j.srs.2026.100466},
	abstract = {Accurate mapping of tree species from satellite data remains challenging in heterogeneous mountain forests due to environmental gradients, mixed stands, and limited training labels. Geospatial foundation models ({GFMs}) learn rich representations from large multi-sensor archives, but their utility for species-level mapping remains unclear. Here, we evaluate two {GFM} embeddings, {AlphaEarth} and Tessera, for tree species classification in a demanding mountain landscape (Trentino, Italy; 18 species and groups), versus conventional Sentinel-1+2 composites, across experiments spanning classification accuracy, label efficiency, classifier complexity, environmental covariates, label impurity, and temporal transferability. {GFM} embeddings consistently outperform conventional baselines (weighted F1 = 0.83 vs. 0.80; macro F1 = 0.55 vs. 0.50), approaching saturation with only 5\% of training parcels while organising species into ecologically meaningful taxonomic and functional groupings. Realising this advantage requires a nonlinear classifier: a compact neural network yields the largest single gain, whereas a linear classifier on {GFM} embeddings underperforms a neural network on conventional composites. Classification is robust to moderate label impurity, and training with parcel-level species proportions as soft labels improves minority-species discrimination (macro F1 = 0.586 –0.589) without purity filtering; adding terrain-derived covariates provides no further benefit. Temporal transfer across years degrades performance: weighted F1 falls from 0.84 to 0.77 (−9\%) for Tessera and from 0.85 to 0.73 (−14\%) for {AlphaEarth}, with disproportionate losses for rare species. These results show that {GFMs} shift the primary bottleneck in species mapping from feature engineering toward the availability, quality, and temporal alignment of reference data.},
	pages = {100466},
	journaltitle = {Science of Remote Sensing},
	shortjournal = {Science of Remote Sensing},
	author = {Ball, James G. C. and Wicklein, Jana Annika and Feng, Zhengpeng and Knezevic, Jovana and Jaffer, Sadiq and Madhavapeddy, Anil and Atzberger, Clement and Dalponte, Michele and Coomes, David A.},
	urldate = {2026-08-24},
	date = {2026-12-01},
	keywords = {Remote sensing, Mountain forests, Biodiversity monitoring, Geospatial foundation models, Tree species classification},
	file = {ScienceDirect Full Text PDF:/Users/schwartz/Zotero/storage/HIYCIMII/Ball et al. - 2026 - Geospatial foundation models enable data-efficient tree species mapping in temperate mountain forest.pdf:application/pdf;ScienceDirect Snapshot:/Users/schwartz/Zotero/storage/LRY89UDG/S2666017226001045.html:text/html},
}

@article{mohrRegenerationResponsePostdisturbance2026,
	title = {Regeneration response to post-disturbance forest management in Central Europe},
	volume = {63},
	issn = {1365-2664},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/1365-2664.70535},
	doi = {10.1111/1365-2664.70535},
	abstract = {Forest disturbances are increasing in many parts of the world. To ensure the continuous provisioning of ecosystem services, a rapid recovery of disturbed sites is frequently an important objective of forest management. However, as management interventions are costly and can have unintended ecological consequences, there is an ongoing debate about whether active post-disturbance management is necessary to support forest recovery and shape the reorganization of forest ecosystems. Studying forests after the largest disturbance event observed in Central Europe in the past 170 years, caused mainly by drought and subsequent bark beetle outbreaks, we quantified the effect of different post-disturbance management activities on regeneration outcomes. In 2023, we surveyed 868 plots situated in disturbance hotspot areas across 11 countries to assess the prevalence of different post-disturbance management activities and evaluate their effects on forest regeneration 3–5 years after disturbance. We found signs of active post-disturbance management on 93.9\% of all surveyed plots. Regeneration cover, sapling density, tree species richness and early-seral species increased when a combination of management measures—salvage logging followed by tree planting and protection against ungulate browsing—was applied. In contrast, salvage logging alone did not have strong effects on regeneration except shifting species composition towards early-seral stages. Tree height of post-disturbance regeneration was not influenced by management. Synthesis and applications. Active management significantly enhanced post-disturbance tree regeneration in Central European disturbance hotspots. We found that the widespread recuperation of timber value by salvage logging had no detrimental effects on tree regeneration and subsequent stand development. Tree planting and browsing protection reduced the share of Norway spruce—a species increasingly maladapted under climate change—and increased tree species diversity, indicating active climate adaptation in Central European forestry. We conclude that carefully managing the short window of reorganization after disturbance provides high leverage for shaping the future of forests in Central Europe.},
	pages = {e70535},
	number = {8},
	journaltitle = {Journal of Applied Ecology},
	author = {Mohr, Johannes S. and Schattenberg, Christian and Potterf, Mária and Braziunas, Kristin H. and Dollinger, Christina and Erhardt, Aikio T. and Gégout, Jean-Claude and Geres, Lisa and Greiner, Sina and Grünig, Marc and Hlásny, Tomáš and Hochholzer, Kilian and Huber, Anne and Kerber, Jonas and Krüger, Kirsten and Lecina-Diaz, Judit and Mandl, Lisa and Modlinger, Roman and Mazón, Miguel Muñoz and Pinto, Paulina E. and Rammer, Werner and Richter, Tobias and Seibold, Sebastian and Senf, Cornelius and Serra-Diaz, Josep M. and Stritih, Ana and Thom, Dominik and Viana-Soto, Alba and Zou, Jiayun and Seidl, Rupert},
	urldate = {2026-08-24},
	date = {2026},
	langid = {english},
	keywords = {forest resilience, forest ecosystem management, forest reorganization, ground-based inventory, planting, salvage logging, tree establishment, ungulate browsing},
	file = {Full Text PDF:/Users/schwartz/Zotero/storage/GJKIH2HD/Mohr et al. - 2026 - Regeneration response to post-disturbance forest management in Central Europe.pdf:application/pdf;Snapshot:/Users/schwartz/Zotero/storage/PZWFZ6SZ/1365-2664.html:text/html},
}

