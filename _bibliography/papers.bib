2 citations (Semantic Scholar/{DOI}) [2026-01-06]},
	keywords = {Forestry, Ecosystem services, Climate-change impacts, Ecological modelling, Environmental economics},
	file = {Full Text PDF:/Users/schwartz/Zotero/storage/CCTS9CBS/Mohr et al. - 2025 - Rising cost of disturbances for forestry in Europe under climate change.pdf:application/pdf},
