@article{meyerCanopyAreaLarge2018,
	title = {Canopy Area of Large Trees Explains Aboveground Biomass Variations across Neotropical Forest Landscapes},
	volume = {15},
	issn = {1726-4189},
	doi = {10.5194/bg-15-3377-2018},
	abstract = {Abstract. Large tropical trees store significant amounts of carbon in woody components and their distribution plays an important role in forest carbon stocks and dynamics. Here, we explore the properties of a new lidar-derived index, the large tree canopy area ({LCA}) defined as the area occupied by canopy above a reference height. We hypothesize that this simple measure of forest structure representing the crown area of large canopy trees could consistently explain the landscape variations in forest volume and aboveground biomass ({AGB}) across a range of climate and edaphic conditions. To test this hypothesis, we assembled a unique dataset of high-resolution airborne light detection and ranging (lidar) and ground inventory data in nine undisturbed old-growth Neotropical forests, of which four had plots large enough (1{\textbackslash},ha) to calibrate our model. We found that the {LCA} for trees greater than 27{\textbackslash},m ({\textbackslash}sim{\textbackslash},25– 30{\textbackslash},m) in height and at least 100{\textbackslash},m2 crown size in a unit area (1{\textbackslash},ha), explains more than 75{\textbackslash},\% of total forest volume variations, irrespective of the forest biogeographic conditions. When weighted by average wood density of the stand, {LCA} can be used as an unbiased estimator of {AGB} across sites (R2{\textbackslash},={\textbackslash},0.78, {RMSE}{\textbackslash},={\textbackslash},46.02{\textbackslash},Mg{\textbackslash},ha-1, bias ={\textbackslash},-0.63{\textbackslash},Mg{\textbackslash},ha-1). Unlike other lidar-derived metrics with complex nonlinear relations to biomass, the relationship between {LCA} and {AGB} is linear and remains unique across forest types. A comparison with tree inventories across the study sites indicates that {LCA} correlates best with the crown area (or basal area) of trees with diameter greater than 50{\textbackslash},cm. The spatial invariance of the {LCA}– {AGB} relationship across the Neotropics suggests a remarkable regularity of forest structure across the landscape and a new technique for systematic monitoring of large trees for their contribution to {AGB} and changes associated with selective logging, tree mortality and other types of tropical forest disturbance and dynamics.},
	pages = {3377--3390},
	number = {11},
	journaltitle = {Biogeosciences},
	author = {Meyer, Victoria and Saatchi, Sassan and Clark, David B. and Keller, Michael and Vincent, Grégoire and Ferraz, António and Espírito-Santo, Fernando and d'Oliveira, Marcus V. N. and Kaki, Dahlia and Chave, Jérôme},
	urldate = {2023-03-17},
	date = {2018-06},
	note = {48 citations (Crossref/{DOI}) [2026-01-07]},
}

